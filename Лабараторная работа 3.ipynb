    ax.set_xlabel("t-SNE 1")
    ax.set_ylabel("t-SNE 2")
    ax.grid(True, alpha=0.3)

handles = [plt.Line2D([0], [0], marker="o", color="w",
                       markerfacecolor=colors_map[g], markersize=8, label=g)
           for g in unique_goods]
fig.legend(handles=handles, loc="lower center", ncol=len(unique_goods), fontsize=10)
plt.suptitle("t-SNE: perplexity influence", fontsize=14)
plt.tight_layout(rect=[0, 0.06, 1, 0.96])
out_tsne = os.path.join(out_dir, "task5_tsne.png")
plt.savefig(out_tsne, dpi=120, bbox_inches="tight")
plt.close()
print("t-SNE saved:", out_tsne)


print("UMAP: per n_neighbors / min_dist")
umap_configs = [
    {"n_neighbors": 5,  "min_dist": 0.1},
    {"n_neighbors": 15, "min_dist": 0.1},
    {"n_neighbors": 50, "min_dist": 0.1},
    {"n_neighbors": 15, "min_dist": 0.5},
    {"n_neighbors": 15, "min_dist": 0.0},
]

umap_results = {}

for cfg in umap_configs:
