plt.close()
print(f"График PC1-PC2: {out2}")

# ============================================================
# ГРАФИК 3. Все пары PC для полноты
# ============================================================
fig, axes = plt.subplots(2, 3, figsize=(15, 9))
pairs = [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]
for ax, (i, j) in zip(axes.flatten(), pairs):
    for g in unique_goods:
