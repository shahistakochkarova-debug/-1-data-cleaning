# 2.2. Убираем выбросы
before = len(df)
df = df[(df["количество"] >= 1) & (df["количество"] <= 10)]
print(f"Удалено строк с выбросом 'количество': {before - len(df)}")

before = len(df)
df = df[(df["цена"] > 0) & (df["цена"] < 100000)]
