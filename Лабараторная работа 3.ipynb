print("=" * 60)
found = False
for i in range(len(corr.columns)):
    for j in range(i + 1, len(corr.columns)):
        c = corr.iloc[i, j]
        if abs(c) > 0.5:
            print(f"  {corr.columns[i]} <-> {corr.columns[j]}: r = {c:.3f}")
            found = True
if not found:
    print("  Сильно коррелирующих пар (|r| > 0.5) не найдено.")
    print("  Максимальная корреляция по модулю:")
    max_corr = 0
    max_pair = None
    for i in range(len(corr.columns)):
        for j in range(i + 1, len(corr.columns)):
            if abs(corr.iloc[i, j]) > abs(max_corr):
                max_corr = corr.iloc[i, j]
                max_pair = (corr.columns[i], corr.columns[j])
    print(f"    {max_pair[0]} <-> {max_pair[1]}: r = {max_corr:.3f}")

print("\nГотово.")


# %% [markdown]
# ## Задание 2. PCA с нуля на NumPy + сравнение со sklearn

# %%
import os
import numpy as np
import pandas as pd
from sklearn.decomposition import PCA as SklearnPCA


base = os.path.dirname(os.path.abspath("__file__"))
path = os.path.join(base, "data", "data.xlsx")


# ============================================================
# 1. Загрузка и предобработка (та же, что в задании 1)
# ============================================================
def load_and_clean(path):
    df = pd.read_excel(path)
    df = df.drop_duplicates()
    df = df[(df["количество"] >= 1) & (df["количество"] <= 10)]
    df = df[(df["цена"] > 0) & (df["цена"] < 100000)]
    df = df[(df["возраст"].isna()) | ((df["возраст"] >= 18) & (df["возраст"] <= 80))]
    df["скидка_%"] = df["скидка_%"].fillna(df["скидка_%"].mean())
    df["возраст"] = df["возраст"].fillna(df["возраст"].mean())
    return df


df = load_and_clean(path)
X = df[["количество", "цена", "скидка_%", "возраст"]].values
print(f"Исходные данные: {X.shape[0]} объектов, {X.shape[1]} признаков")


# ============================================================
# 2. PCA С НУЛЯ НА NUMPY
# ============================================================
print("\n" + "=" * 60)
print("PCA С НУЛЯ (NumPy)")
print("=" * 60)


def pca_from_scratch(X, n_components=None):
    """
    Реализация PCA с нуля.
    Возвращает: X_projected, components, eigenvalues, mean, std
    """
    # --- Шаг 1. Стандартизация ---
    mean = X.mean(axis=0)
    std = X.std(axis=0, ddof=0)
    X_std = (X - mean) / std

    # --- Шаг 2. Ковариационная матрица ---
    n = X_std.shape[0]
    cov_matrix = (X_std.T @ X_std) / n
    print(f"Ковариационная матрица: {cov_matrix.shape}")
    print(np.round(cov_matrix, 4))

    # --- Шаг 3. Собственные значения и векторы ---
    eigenvalues, eigenvectors = np.linalg.eigh(cov_matrix)
    idx = np.argsort(eigenvalues)[::-1]
    eigenvalues = eigenvalues[idx]
    eigenvectors = eigenvectors[:, idx]
    print(f"\nСобственные значения (по убыванию):")
    print(np.round(eigenvalues, 6))

    # --- Шаг 4. Выбираем k компонент ---
    if n_components is None:
        n_components = X.shape[1]
    components = eigenvectors[:, :n_components]
    print(f"\nВыбрано компонент: {n_components}")

    # --- Шаг 5. Проекция ---
    X_projected = X_std @ components

    return X_projected, components, eigenvalues, mean, std


X_pca_scratch, comp_scratch, eig_scratch, mean_s, std_s = pca_from_scratch(X, n_components=4)

print(f"\nРезультат PCA с нуля: {X_pca_scratch.shape}")


# ============================================================
# 3. СРАВНЕНИЕ СО SKLEARN
# ============================================================
print("\n" + "=" * 60)
print("СРАВНЕНИЕ СО SKLEARN")
print("=" * 60)

X_std_sk = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)
pca_sk = SklearnPCA(n_components=4)
X_pca_sk = pca_sk.fit_transform(X_std_sk)

print(f"Sklearn PCA: {X_pca_sk.shape}")
print(f"\nСобственные значения (sklearn):")
print(np.round(pca_sk.explained_variance_, 6))
print(f"\nСобственные значения (наш PCA):")
print(np.round(eig_scratch, 6))

print("\n" + "=" * 60)
print("ПРОВЕРКА СОВПАДЕНИЯ")
print("=" * 60)

for i in range(4):
    corr = np.corrcoef(X_pca_scratch[:, i], X_pca_sk[:, i])[0, 1]
    print(f"  Компонента {i+1}: корреляция = {corr:+.6f}")

print("\nЕсли корреляции ≈ ±1 — реализация верна.")

explained_var = eig_scratch / eig_scratch.sum()
cumulative_var = np.cumsum(explained_var)

print("\n" + "=" * 60)
print("ДОЛИ ОБЪЯСНЁННОЙ ДИСПЕРСИИ")
print("=" * 60)
print(f"{'Компонента':<12}{'Доля':<12}{'Накопленная':<12}")
print("-" * 36)
for i, (e, c) in enumerate(zip(explained_var, cumulative_var)):
    print(f"PC{i+1:<10}{e:<12.4f}{c:<12.4f}")


# %% [markdown]
# ## Задание 2.1. График объяснённой дисперсии PCA

# %%
import os
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt


base = os.path.dirname(os.path.abspath("__file__"))
path = os.path.join(base, "data", "data.xlsx")
out_dir = os.path.join(base, "results")


def load_and_clean(path):
    df = pd.read_excel(path)
    df = df.drop_duplicates()
    df = df[(df["количество"] >= 1) & (df["количество"] <= 10)]
    df = df[(df["цена"] > 0) & (df["цена"] < 100000)]
    df = df[(df["возраст"].isna()) | ((df["возраст"] >= 18) & (df["возраст"] <= 80))]
    df["скидка_%"] = df["скидка_%"].fillna(df["скидка_%"].mean())
    df["возраст"] = df["возраст"].fillna(df["возраст"].mean())
    return df


def pca_from_scratch(X):
    mean = X.mean(axis=0)
    std = X.std(axis=0, ddof=0)
    X_std = (X - mean) / std
    n = X_std.shape[0]
    cov = (X_std.T @ X_std) / n
    eigvals, eigvecs = np.linalg.eigh(cov)
    idx = np.argsort(eigvals)[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]
    return X_std @ eigvecs, eigvals, eigvecs


df = load_and_clean(path)
X = df[["количество", "цена", "скидка_%", "возраст"]].values

X_pca, eigvals, eigvecs = pca_from_scratch(X)

explained = eigvals / eigvals.sum()
cumulative = np.cumsum(explained)
n_components = len(eigvals)
comps = np.arange(1, n_components + 1)

print("=" * 60)
print("ОБЪЯСНЁННАЯ ДИСПЕРСИЯ")
print("=" * 60)
print(f"{'PC':<6}{'Собств. зн.':<15}{'Доля':<12}{'Накопленная':<12}")
print("-" * 45)
for i, (e, s, c) in enumerate(zip(eigvals, explained, cumulative)):
    print(f"PC{i+1:<4}{e:<15.4f}{s:<12.4f}{c:<12.4f}")

def n_for_threshold(cumulative, threshold):
    for i, c in enumerate(cumulative):
        if c >= threshold:
            return i + 1
    return len(cumulative)

n80 = n_for_threshold(cumulative, 0.80)
n95 = n_for_threshold(cumulative, 0.95)

print(f"\nКомпонент для 80% дисперсии: {n80}")
print(f"Компонент для 95% дисперсии: {n95}")

fig, ax1 = plt.subplots(figsize=(9, 5))

color_bars = "steelblue"
ax1.bar(comps, explained, color=color_bars, alpha=0.7,
        edgecolor="black", label="Доля дисперсии")
ax1.set_xlabel("Номер главной компоненты", fontsize=12)
ax1.set_ylabel("Доля объяснённой дисперсии", color=color_bars, fontsize=12)
ax1.tick_params(axis="y", labelcolor=color_bars)
ax1.set_xticks(comps)
ax1.set_ylim(0, 1.05)

ax2 = ax1.twinx()
color_line = "crimson"
ax2.plot(comps, cumulative, color=color_line, marker="o",
         linewidth=2, markersize=10, label="Накопленная дисперсия")
ax2.set_ylabel("Накопленная дисперсия", color=color_line, fontsize=12)
ax2.tick_params(axis="y", labelcolor=color_line)
ax2.set_ylim(0, 1.05)

ax2.axhline(0.80, color="green", linestyle="--", alpha=0.6,
            label="80% дисперсии")
ax2.axhline(0.95, color="orange", linestyle="--", alpha=0.6,
            label="95% дисперсии")

for i, c in enumerate(cumulative):
    ax2.annotate(f"{c:.3f}", (comps[i], c),
                 textcoords="offset points", xytext=(0, 8),
                 ha="center", fontsize=9, color=color_line)

plt.title("Объяснённая дисперсия главных компонент", fontsize=13)
fig.tight_layout()
out = os.path.join(out_dir, "task2_1_variance.png")
plt.savefig(out, dpi=120, bbox_inches="tight")
plt.close()
print(f"\nГрафик сохранён: {out}")


