# ## Задание 3. Интерпретация главных компонент

# %%
import os
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt


base = os.path.dirname(os.path.abspath("__file__"))
path = os.path.join(base, "data", "data.xlsx")
out_dir = os.path.join(base, "results")


def load_and_clean(path):
    df = pd.read_excel(path)
    df = df.drop_duplicates()
    df = df[(df["количество"] >= 1) & (df["количество"] <= 10)]
    df = df[(df["цена"] > 0) & (df["цена"] < 100000)]
    df = df[(df["возраст"].isna()) | ((df["возраст"] >= 18) & (df["возраст"] <= 80))]
    df["скидка_%"] = df["скидка_%"].fillna(df["скидка_%"].mean())
    df["возраст"] = df["возраст"].fillna(df["возраст"].mean())
    return df


def pca_from_scratch(X):
    mean = X.mean(axis=0)
    std = X.std(axis=0, ddof=0)
    X_std = (X - mean) / std
    n = X_std.shape[0]
    cov = (X_std.T @ X_std) / n
    eigvals, eigvecs = np.linalg.eigh(cov)
    idx = np.argsort(eigvals)[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]
    return X_std @ eigvecs, eigvals, eigvecs, mean, std


df = load_and_clean(path)
features = ["количество", "цена", "скидка_%", "возраст"]
X = df[features].values

X_pca, eigvals, eigvecs, mean, std = pca_from_scratch(X)

loadings = pd.DataFrame(
    eigvecs,
    index=features,
    columns=[f"PC{i+1}" for i in range(eigvecs.shape[1])]
)

print("=" * 60)
print("НАГРУЗКИ (LOADINGS): КОЭФФИЦИЕНТЫ ПРИЗНАКОВ В КОМПОНЕНТАХ")
print("=" * 60)
print(loadings.round(4).to_string())

print("\n" + "=" * 60)
print("ВКЛАД ПРИЗНАКОВ В КАЖДУЮ КОМПОНЕНТУ")
print("=" * 60)

for pc in loadings.columns:
    print(f"\n{pc}:")
    sorted_load = loadings[pc].abs().sort_values(ascending=False)
    for feat in sorted_load.index:
        val = loadings.loc[feat, pc]
        bar = "█" * int(abs(val) * 40)
        print(f"  {feat:<12} {val:+.4f}  {bar}")

print("\n" + "=" * 60)
print("ОТВЕТЫ НА ВОПРОСЫ ЗАДАНИЯ 3")
print("=" * 60)

pc1 = loadings["PC1"].abs().sort_values(ascending=False)
print(f"\n1. Признаки, влияющие на PC1 (по модулю):")
for feat in pc1.index:
    print(f"   {feat}: {loadings.loc[feat, 'PC1']:+.4f}")
print(f"   -> Больше всего: {pc1.index[0]} ({loadings.loc[pc1.index[0], 'PC1']:+.4f})")

print(f"\n2. Интерпретация PC1:")
pc1_vals = loadings["PC1"]
dominant = pc1_vals.abs().idxmax()
print(f"   PC1 — комбинация всех признаков, но главный — {dominant}.")
print(f"   Знаки: {dict(pc1_vals.round(3))}")
print(f"   Если все знаки одного направления — PC1 можно назвать 'общий размер/масштаб'.")
print(f"   Если знаки разные — PC1 — 'контраст' между положительными и отрицательными.")

print(f"\n3. Признаки со слабым влиянием (|loading| < 0.3):")
found_weak = False
for pc in loadings.columns:
    for feat in features:
        v = abs(loadings.loc[feat, pc])
        if v < 0.3:
            print(f"   {pc} <- {feat}: {loadings.loc[feat, pc]:+.4f}")
            found_weak = True
if not found_weak:
    print("   Все признаки влияют на все компоненты (|loading| >= 0.3).")

fig, ax = plt.subplots(figsize=(9, 6))
im = ax.imshow(loadings.values, cmap="RdBu_r", vmin=-1, vmax=1, aspect="auto")
ax.set_xticks(range(loadings.shape[1]))
ax.set_xticklabels(loadings.columns, fontsize=12)
ax.set_yticks(range(len(features)))
ax.set_yticklabels(features, fontsize=12)

for i in range(loadings.shape[0]):
    for j in range(loadings.shape[1]):
        ax.text(j, i, f"{loadings.values[i, j]:+.3f}",
                ha="center", va="center",
                color="white" if abs(loadings.values[i, j]) > 0.5 else "black",
                fontsize=11)

ax.set_title("Нагрузки признаков на главные компоненты", fontsize=13)
plt.colorbar(im, ax=ax, label="Коэффициент")
plt.tight_layout()
out = os.path.join(out_dir, "task3_loadings.png")
plt.savefig(out, dpi=120, bbox_inches="tight")
plt.close()
print(f"\nВизуализация нагрузок сохранена: {out}")

fig, ax = plt.subplots(figsize=(9, 6))
goods = df["товар"].values
unique_goods = sorted(set(goods))
colors = plt.cm.tab10(np.linspace(0, 1, len(unique_goods)))
for i, g in enumerate(unique_goods):
    mask = goods == g
    ax.scatter(X_pca[mask, 0], X_pca[mask, 1], label=g, alpha=0.6,
               color=colors[i], edgecolors="black", linewidths=0.3, s=40)
ax.set_xlabel("PC1", fontsize=12)
ax.set_ylabel("PC2", fontsize=12)
ax.set_title("Данные в пространстве PC1-PC2, окрашены по товару", fontsize=13)
ax.legend(loc="best", fontsize=9)
ax.grid(True, alpha=0.3)
plt.tight_layout()
out2 = os.path.join(out_dir, "task3_pc1_pc2.png")
plt.savefig(out2, dpi=120, bbox_inches="tight")
plt.close()
print(f"Scatter PC1-PC2 сохранён: {out2}")


