colors_map = {g: plt.cm.tab10(i / len(unique_goods)) for i, g in enumerate(unique_goods)}


print("t-SNE: per perplexity")
perplexities = [5, 30, 50]
tsne_results = {}

for perp in perplexities:
    print("Running t-SNE, perplexity =", perp)
    tsne = TSNE(
        n_components=2,
        perplexity=perp,
        random_state=42,
        init="pca",
        learning_rate="auto",
        max_iter=1000,
    )
    X_tsne = tsne.fit_transform(X_std)
    tsne_results[perp] = X_tsne
    print("  Done. Shape:", X_tsne.shape)

fig, axes = plt.subplots(1, 3, figsize=(18, 6))
for ax, perp in zip(axes, perplexities):
    X_tsne = tsne_results[perp]
    for g in unique_goods:
        mask = goods == g
        ax.scatter(X_tsne[mask, 0], X_tsne[mask, 1],
                   color=colors_map[g], label=g, alpha=0.7,
                   edgecolors="black", linewidths=0.3, s=45)
