# ## Задание 6. Сжатие и восстановление (MSE)

# %%
import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt


base = os.path.dirname(os.path.abspath("__file__"))
path = os.path.join(base, "data", "data.xlsx")
out_dir = os.path.join(base, "results")


def load_and_clean(path):
    df = pd.read_excel(path)
    df = df.drop_duplicates()
    df = df[(df["количество"] >= 1) & (df["количество"] <= 10)]
    df = df[(df["цена"] > 0) & (df["цена"] < 100000)]
    df = df[(df["возраст"].isna()) | ((df["возраст"] >= 18) & (df["возраст"] <= 80))]
    df["скидка_%"] = df["скидка_%"].fillna(df["скидка_%"].mean())
    df["возраст"] = df["возраст"].fillna(df["возраст"].mean())
    return df


def pca_fit(X):
    mean = X.mean(axis=0)
    std = X.std(axis=0, ddof=0)
    X_std = (X - mean) / std
    n = X_std.shape[0]
    cov = (X_std.T @ X_std) / n
    eigvals, eigvecs = np.linalg.eigh(cov)
    idx = np.argsort(eigvals)[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]
    return X_std, mean, std, eigvecs, eigvals


def pca_reconstruct(X_std, components_k, mean, std):
    X_red = X_std @ components_k
    X_rec_std = X_red @ components_k.T
    X_rec = X_rec_std * std + mean
    return X_rec


def mse(a, b):
    return float(np.mean((a - b) ** 2))


df = load_and_clean(path)
features = ["количество", "цена", "скидка_%", "возраст"]
X = df[features].values
X_std, mean, std, eigvecs, eigvals = pca_fit(X)

print("=" * 60)
print("ЗАДАНИЕ 6. СЖАТИЕ И ВОССТАНОВЛЕНИЕ PCA")
print("=" * 60)
print("Исходных признаков:", X.shape[1])
print("Объектов:", X.shape[0])
print()

ks = [1, 2, 3, 4]
mse_list = []
mse_per_feature = []

for k in ks:
    components_k = eigvecs[:, :k]
    X_rec = pca_reconstruct(X_std, components_k, mean, std)
    err = mse(X, X_rec)
    mse_list.append(err)

    per_feat = [mse(X[:, i], X_rec[:, i]) for i in range(X.shape[1])]
    mse_per_feature.append(per_feat)

    print("k =", k)
    print("  Общий MSE:", round(err, 4))
    print("  MSE по признакам:")
    for i, f in enumerate(features):
        print("    " + f + ": " + str(round(per_feat[i], 4)))
    print()

print("=" * 60)
print("ТАБЛИЦА: MSE vs число компонент")
print("=" * 60)
print("k    MSE")
for k, m in zip(ks, mse_list):
    print(str(k) + "    " + str(round(m, 4)))

fig, ax = plt.subplots(figsize=(8, 5))
ax.plot(ks, mse_list, marker="o", linewidth=2, markersize=12, color="crimson")
for k, m in zip(ks, mse_list):
    ax.annotate(str(round(m, 2)), (k, m),
                textcoords="offset points", xytext=(0, 12),
                ha="center", fontsize=11)

ax.set_xlabel("Число компонент (k)", fontsize=12)
ax.set_ylabel("MSE восстановления", fontsize=12)
ax.set_title("Ошибка восстановления vs число компонент", fontsize=13)
ax.grid(True, alpha=0.3)
ax.set_xticks(ks)
plt.tight_layout()
out1 = os.path.join(out_dir, "task6_mse.png")
plt.savefig(out1, dpi=120, bbox_inches="tight")
plt.close()
print("\nГрафик MSE сохранён:", out1)

fig, ax = plt.subplots(figsize=(9, 5))
mse_pf = np.array(mse_per_feature)
for i, f in enumerate(features):
    ax.plot(ks, mse_pf[:, i], marker="o", label=f, linewidth=2)

ax.set_xlabel("Число компонент (k)", fontsize=12)
ax.set_ylabel("MSE по признаку", fontsize=12)
ax.set_title("Ошибка восстановления по каждому признаку", fontsize=13)
ax.legend(loc="best", fontsize=11)
ax.grid(True, alpha=0.3)
ax.set_xticks(ks)
plt.tight_layout()
out2 = os.path.join(out_dir, "task6_mse_per_feature.png")
plt.savefig(out2, dpi=120, bbox_inches="tight")
plt.close()
print("График MSE по признакам сохранён:", out2)

print()
print("=" * 60)
print("ПРИМЕР: Исходные vs восстановленные (первые 5 строк, k=2)")
print("=" * 60)

components_k2 = eigvecs[:, :2]
X_rec_k2 = pca_reconstruct(X_std, components_k2, mean, std)

print("Исходные данные (первые 5):")
print(np.round(X[:5], 2))
print()
print("Восстановленные (k=2):")
print(np.round(X_rec_k2[:5], 2))

print()
print("DONE.")


